new("UICorner", {CornerRadius = UDim.new(0, 8)}, box)

local function button(text, x, color)
	local b = new("TextButton", {
		Size = UDim2.new(0.5, -26, 0, 34),
		Position = UDim2.new(x, x == 0 and 20 or 6, 0, 98),
		BackgroundColor3 = color,
		Text = text,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 13,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = true
	}, frame)
	new("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
	return b
end

local submitButton = button("Войти", 0.5, Color3.fromRGB(60, 120, 255))
local getButton = button("Получить ключ", 0, Color3.fromRGB(40, 40, 40))

local status = new("TextLabel", {
	Size = UDim2.new(1, -40, 0, 40),
	Position = UDim2.fromOffset(20, 146),
	BackgroundTransparency = 1,
	Text = "",
	TextColor3 = Color3.fromRGB(180, 180, 180),
	TextSize = 12,
	Font = Enum.Font.Gotham,
	TextWrapped = true
}, frame)

local busy = false

local function submit(key)
	key = (key:gsub("%s", ""))
	if busy or key == "" then return end
	busy = true
	status.TextColor3 = Color3.fromRGB(180, 180, 180)
	status.Text = "Проверка..."
	task.spawn(function()
		local source, reason = fetchHub(key)
		if not source then
			busy = false
			status.TextColor3 = Color3.fromRGB(255, 90, 90)
			status.Text = reason
			return
		end
		pcall(writefile, KEY_FILE, key)
		gui:Destroy()
		local fn, err = loadstring(source)
		if fn then fn() else warn(err) end
	end)
end

submitButton.MouseButton1Click:Connect(function() submit(box.Text) end)
box.FocusLost:Connect(function(enter) if enter then submit(box.Text) end end)

getButton.MouseButton1Click:Connect(function()
	local copied = pcall(setclipboard, INVITE)
	status.TextColor3 = Color3.fromRGB(180, 180, 180)
	status.Text = copied and "Ссылка на Discord скопирована. Напиши /getkey в сервере" or INVITE
end)

local saved = isfile and isfile(KEY_FILE) and readfile(KEY_FILE)
if saved and saved ~= "" then
	box.Text = saved
	submit(saved)
end
