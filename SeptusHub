local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Analytics = game:GetService("RbxAnalyticsService")

local API = "https://septus-keys.sx-api.workers.dev"
local INVITE = "https://discord.gg/https://discord.gg/bzP4HwTsx"
local KEY_FILE = "SeptusHub_Key.txt"

local httpRequest = request or http_request or (syn and syn.request)
local hwid = Analytics:GetClientId()

local messages = {
	invalid = "Неверный ключ",
	expired = "Ключ истёк. Получи новый командой /getkey",
	hwid = "Ключ привязан к другому устройству. Используй /resetkey",
	retry = "Попробуй ещё раз",
	server = "Ошибка сервера"
}

local function fetchHub(key)
	if not httpRequest then return nil, "Экзекьютор не поддерживает request" end
	local ok, response = pcall(httpRequest, {
		Url = API .. "/script",
		Method = "POST",
		Headers = {["Content-Type"] = "application/json"},
		Body = HttpService:JSONEncode({key = key, hwid = hwid})
	})
	if not ok or not response then return nil, "Нет соединения с сервером" end
	if response.StatusCode == 200 then return response.Body end
	local decoded, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
	return nil, messages[decoded and data.reason or ""] or "Ошибка сервера"
end

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	inst.Parent = parent
	return inst
end

local gui = new("ScreenGui", {Name = "SeptusKey", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 2147483647})
local mounted, container = pcall(function() return gethui and gethui() or game:GetService("CoreGui") end)
gui.Parent = mounted and container or Players.LocalPlayer:WaitForChild("PlayerGui")

local frame = new("Frame", {
	Size = UDim2.fromOffset(340, 200),
	Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundColor3 = Color3.fromRGB(16, 16, 16)
}, gui)
new("UICorner", {CornerRadius = UDim.new(0, 10)}, frame)
new("UIStroke", {Color = Color3.fromRGB(50, 50, 50)}, frame)

new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 40),
	BackgroundTransparency = 1,
	Text = "Septus Hub — ключ",
	TextColor3 = Color3.new(1, 1, 1),
	TextSize = 16,
	Font = Enum.Font.GothamBold
}, frame)

local box = new("TextBox", {
	Size = UDim2.new(1, -40, 0, 36),
	Position = UDim2.fromOffset(20, 50),
	BackgroundColor3 = Color3.fromRGB(28, 28, 28),
	Text = "",
	PlaceholderText = "SEPT-XXXX-XXXX-XXXX",
